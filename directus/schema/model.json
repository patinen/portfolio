{
  "format": "portfolio-review-model-v1",
  "note": "Declarative review specification, NOT a Directus native snapshot. No application script or live mutation.",
  "collections": {
    "languages": {
      "primary_key": "code",
      "fields": {
        "code": "string",
        "name": "string"
      },
      "seed": [
        {
          "code": "en",
          "name": "English"
        },
        {
          "code": "fi",
          "name": "Suomi"
        }
      ]
    },
    "site_settings": {
      "singleton": true,
      "fields": {
        "id": "integer",
        "github_url": "string",
        "linkedin_url": "string",
        "email": "string",
        "cv_file": "uuid",
        "availability_enabled": "boolean",
        "default_og_image": "uuid"
      },
      "primary_key": "id",
      "aliases": {
        "translations": "O2M site_settings_translations"
      }
    },
    "projects": {
      "fields": {
        "id": "uuid",
        "slug": "string unique",
        "status": "string draft|published|archived default:draft",
        "featured": "boolean default:false",
        "sort_order": "integer",
        "cover_image": "uuid",
        "hero_image": "uuid",
        "architecture_image": "uuid",
        "github_url": "string",
        "live_url": "string",
        "started_at": "date",
        "completed_at": "date",
        "ongoing": "boolean"
      },
      "primary_key": "id",
      "public_read_filter": {
        "status": {
          "_eq": "published"
        }
      },
      "aliases": {
        "translations": "O2M projects_translations",
        "media": "O2M project_media",
        "technologies": "M2M technologies via projects_technologies"
      }
    },
    "technologies": {
      "fields": {
        "id": "uuid",
        "status": "string draft|published|archived default:draft",
        "name": "string",
        "slug": "string unique",
        "category": "string",
        "sort_order": "integer",
        "icon": "uuid"
      },
      "primary_key": "id",
      "public_read_filter": {
        "status": {
          "_eq": "published"
        }
      }
    },
    "experience": {
      "fields": {
        "id": "uuid",
        "status": "string draft|published|archived default:draft",
        "organization": "string",
        "url": "string",
        "start_date": "date",
        "end_date": "date",
        "current": "boolean",
        "sort_order": "integer"
      },
      "primary_key": "id",
      "public_read_filter": {
        "status": {
          "_eq": "published"
        }
      },
      "aliases": {
        "translations": "O2M experience_translations"
      }
    },
    "education": {
      "fields": {
        "id": "uuid",
        "status": "string draft|published|archived default:draft",
        "organization": "string",
        "url": "string",
        "start_date": "date",
        "end_date": "date",
        "current": "boolean",
        "sort_order": "integer"
      },
      "primary_key": "id",
      "public_read_filter": {
        "status": {
          "_eq": "published"
        }
      },
      "aliases": {
        "translations": "O2M education_translations"
      }
    },
    "projects_technologies": {
      "fields": {
        "id": "integer",
        "projects_id": "uuid",
        "technologies_id": "uuid"
      },
      "primary_key": "id",
      "unique": ["projects_id", "technologies_id"],
      "public_read_filter": {
        "_and": [
          {
            "projects_id": {
              "status": {
                "_eq": "published"
              }
            }
          },
          {
            "technologies_id": {
              "status": {
                "_eq": "published"
              }
            }
          }
        ]
      }
    },
    "site_settings_translations": {
      "fields": {
        "id": "integer",
        "site_settings_id": "integer",
        "languages_code": "string",
        "site_name": "text",
        "nav_projects": "text",
        "nav_about": "text",
        "nav_experience": "text",
        "nav_contact": "text",
        "hero_eyebrow": "text",
        "hero_headline": "text",
        "hero_intro": "text",
        "hero_primary_cta": "text",
        "hero_secondary_cta": "text",
        "projects_section_label": "text",
        "projects_section_title": "text",
        "about_section_label": "text",
        "about_section_title": "text",
        "about_body": "text",
        "experience_section_label": "text",
        "experience_section_title": "text",
        "education_section_label": "text",
        "education_section_title": "text",
        "contact_section_label": "text",
        "contact_section_title": "text",
        "contact_body": "text",
        "footer_text": "text",
        "seo_title": "text",
        "seo_description": "text",
        "og_image_alt": "text",
        "availability_label": "text",
        "carousel_previous_label": "text",
        "carousel_next_label": "text",
        "locale_switch_label": "text",
        "menu_label": "text",
        "skip_label": "text",
        "current_label": "text",
        "github_label": "text",
        "linkedin_label": "text",
        "email_label": "text",
        "cv_label": "text"
      },
      "unique": ["site_settings_id", "languages_code"],
      "primary_key": "id"
    },
    "projects_translations": {
      "fields": {
        "id": "integer",
        "projects_id": "uuid",
        "languages_code": "string",
        "title": "text",
        "eyebrow": "text",
        "short_description": "text",
        "overview": "text",
        "problem": "text",
        "solution": "text",
        "architecture_intro": "text",
        "key_decisions_intro": "text",
        "lessons": "text",
        "live_label": "text",
        "source_label": "text",
        "cover_alt": "text",
        "hero_alt": "text",
        "architecture_alt": "text",
        "seo_title": "text",
        "seo_description": "text",
        "overview_heading": "text",
        "problem_heading": "text",
        "solution_heading": "text",
        "architecture_intro_heading": "text",
        "key_decisions_intro_heading": "text",
        "lessons_heading": "text",
        "gallery_heading": "text"
      },
      "unique": ["projects_id", "languages_code"],
      "primary_key": "id",
      "public_read_filter": {
        "projects_id": {
          "status": {
            "_eq": "published"
          }
        }
      }
    },
    "experience_translations": {
      "fields": {
        "id": "integer",
        "experience_id": "uuid",
        "languages_code": "string",
        "role": "text",
        "summary": "text",
        "description": "text"
      },
      "unique": ["experience_id", "languages_code"],
      "primary_key": "id",
      "public_read_filter": {
        "experience_id": {
          "status": {
            "_eq": "published"
          }
        }
      }
    },
    "education_translations": {
      "fields": {
        "id": "integer",
        "education_id": "uuid",
        "languages_code": "string",
        "degree": "text",
        "field": "text",
        "summary": "text"
      },
      "unique": ["education_id", "languages_code"],
      "primary_key": "id",
      "public_read_filter": {
        "education_id": {
          "status": {
            "_eq": "published"
          }
        }
      }
    },
    "project_media": {
      "primary_key": "id",
      "fields": {
        "id": "uuid",
        "project_id": "uuid",
        "file": "uuid",
        "sort_order": "integer",
        "decorative": "boolean default:false"
      },
      "aliases": {
        "translations": "O2M project_media_translations"
      },
      "public_read_filter": {
        "project_id": {
          "status": {
            "_eq": "published"
          }
        }
      }
    },
    "project_media_translations": {
      "primary_key": "id",
      "fields": {
        "id": "integer",
        "project_media_id": "uuid",
        "languages_code": "string",
        "alt_text": "text",
        "caption": "text"
      },
      "unique": ["project_media_id", "languages_code"],
      "public_read_filter": {
        "project_media_id": {
          "project_id": {
            "status": {
              "_eq": "published"
            }
          }
        }
      }
    }
  },
  "relations": [
    {
      "collection": "site_settings_translations",
      "field": "site_settings_id",
      "related_collection": "site_settings",
      "reverse_field": "translations",
      "interface": "translations"
    },
    {
      "collection": "site_settings_translations",
      "field": "languages_code",
      "related_collection": "languages"
    },
    {
      "collection": "projects_translations",
      "field": "projects_id",
      "related_collection": "projects",
      "reverse_field": "translations",
      "interface": "translations"
    },
    {
      "collection": "projects_translations",
      "field": "languages_code",
      "related_collection": "languages"
    },
    {
      "collection": "experience_translations",
      "field": "experience_id",
      "related_collection": "experience",
      "reverse_field": "translations",
      "interface": "translations"
    },
    {
      "collection": "experience_translations",
      "field": "languages_code",
      "related_collection": "languages"
    },
    {
      "collection": "education_translations",
      "field": "education_id",
      "related_collection": "education",
      "reverse_field": "translations",
      "interface": "translations"
    },
    {
      "collection": "education_translations",
      "field": "languages_code",
      "related_collection": "languages"
    },
    {
      "collection": "projects_technologies",
      "field": "projects_id",
      "related_collection": "projects",
      "reverse_field": "technologies"
    },
    {
      "collection": "projects_technologies",
      "field": "technologies_id",
      "related_collection": "technologies",
      "reverse_field": null
    },
    {
      "collection": "site_settings",
      "field": "cv_file",
      "related_collection": "directus_files"
    },
    {
      "collection": "site_settings",
      "field": "default_og_image",
      "related_collection": "directus_files"
    },
    {
      "collection": "projects",
      "field": "cover_image",
      "related_collection": "directus_files"
    },
    {
      "collection": "projects",
      "field": "hero_image",
      "related_collection": "directus_files"
    },
    {
      "collection": "projects",
      "field": "architecture_image",
      "related_collection": "directus_files"
    },
    {
      "collection": "technologies",
      "field": "icon",
      "related_collection": "directus_files"
    },
    {
      "collection": "project_media",
      "field": "project_id",
      "related_collection": "projects",
      "reverse_field": "media"
    },
    {
      "collection": "project_media",
      "field": "file",
      "related_collection": "directus_files"
    },
    {
      "collection": "project_media_translations",
      "field": "project_media_id",
      "related_collection": "project_media",
      "reverse_field": "translations",
      "interface": "translations"
    },
    {
      "collection": "project_media_translations",
      "field": "languages_code",
      "related_collection": "languages"
    }
  ],
  "editorial_interfaces": {
    "text_fields": "input or input-multiline; plain text only, never WYSIWYG/HTML",
    "body_fields": [
      "about_body",
      "contact_body",
      "overview",
      "problem",
      "solution",
      "architecture_intro",
      "key_decisions_intro",
      "lessons",
      "summary",
      "description"
    ],
    "body_interface": "input-multiline"
  },
  "publication": {
    "statuses": ["draft", "published", "archived"],
    "default": "draft",
    "public_status": "published",
    "collections": ["projects", "technologies", "experience", "education"],
    "note": "project_media inherits publication from project_id; site_settings is a singleton without status. Permission rules must also protect direct translation, junction and media reads."
  },
  "media_contract": {
    "decorative": "When true, rendered alt is empty; otherwise localized alt_text must be nonblank or the gallery image is omitted.",
    "translation_fallback": "Requested en/fi row, then English row, otherwise missing copy; no field-level merge.",
    "icon": "technologies.icon is an optional M2O to directus_files; technology names/icons are not localized."
  }
}
