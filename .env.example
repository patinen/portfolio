# DIRECTUS_URL is required at build time and runtime. Use a public origin without credentials.
DIRECTUS_URL=https://cms.pat1.online
# Optional runtime-only read token. Leave unset when public reads suffice; never use an admin token.
DIRECTUS_TOKEN=
# Development value below. Set the final HTTPS origin at build time and runtime in Coolify.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quote requests: server-only Gmail SMTP credentials. SMTP_FROM must be the
# authenticated Gmail address (or an address permitted by that account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
QUOTE_TO_EMAIL=
# Upstash Redis REST is required for shared, persistent rate limiting.
QUOTE_RATE_LIMIT_URL=
QUOTE_RATE_LIMIT_TOKEN=
# Random secret used to hash visitor IP addresses before rate-limit storage.
QUOTE_RATE_LIMIT_SECRET=
