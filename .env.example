# DIRECTUS_URL is required at build time and runtime. Use a public origin without credentials.
DIRECTUS_URL=https://cms.pat1.online
# Optional runtime-only read token. Leave unset when public reads suffice; never use an admin token.
DIRECTUS_TOKEN=
# Development value below. Set the final HTTPS origin at build time and runtime in Coolify.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
