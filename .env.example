# DIRECTUS_URL is required at build time and runtime. Use a public origin without credentials.
DIRECTUS_URL=https://cms.pat1.online
# Optional runtime-only read token. Leave unset when public reads suffice; never use an admin token.
DIRECTUS_TOKEN=
# Development value below. Set the final HTTPS origin at build time and runtime in Coolify.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only PersonaCore integration. Keep off before CMS/operations/model evaluation.
PERSONACORE_ENABLED=false
# Exact browser origin; production public origin must use HTTPS.
PERSONACORE_ORIGIN=http://localhost:3000
# Private origin only, no path, credentials, query or fragment.
PERSONACORE_URL=http://personacore:3001
# Separate random secrets, >=32 characters. Never NEXT_PUBLIC variables.
PERSONACORE_BEARER_SECRET=
PERSONACORE_SESSION_SECRET=
PERSONACORE_SESSION_SECONDS=86400
PERSONACORE_TIMEOUT_MS=25000
